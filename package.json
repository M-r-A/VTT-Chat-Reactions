  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-webpack-plugin": "^6.0.0",
    "fvtt-types": "^14.369.0-beta.20261027165341",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "source-map-loader": "^5.0.0",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  },
  "dependencies": {
